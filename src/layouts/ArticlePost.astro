---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import { Image } from "astro:assets";
import Layout from "./Layout.astro";
import { AlertTriangleIcon } from "lucide-react";
import { Badge } from "@/components/ui/badge";
import { ArticleReadingRail } from "@/components/ArticleReadingRail";
import { ArticleShareButton } from "@/components/ArticleShareButton";
import { buildArticleStructuredData } from "@/lib/article-metadata";
import ogImage from "@/assets/og-image.jpg";

type Props = CollectionEntry<"articles">["data"];

const {
  title,
  description,
  date,
  updatedDate,
  heroImage,
  published,
  tags,
  lang,
  archived,
} = Astro.props;

const articleUrl = new URL(Astro.url.pathname, Astro.site).toString();
const structuredData = buildArticleStructuredData({
  title,
  description,
  url: articleUrl,
  imageUrl: new URL((heroImage ?? ogImage).src, Astro.site).toString(),
  language: lang,
  publishedAt: date,
  modifiedAt: updatedDate,
});
---

<Layout
  title={title}
  description={description}
  imageAlt={title}
  lang={lang}
  ogType="article"
  publishedTime={date}
  modifiedTime={updatedDate}
  tags={tags}
  structuredData={structuredData}
>
  <div
    data-article-root
    class="relative pb-10 z-10 min-h-svh pointer-events-auto w-full flex justify-center items-center flex-col"
  >
    <ArticleReadingRail client:load />
    <div class="max-w-full lg:max-w-2xl mx-auto py-6 pl-16 pr-10 space-y-10 xl:p-6">
      <article>
        <div class="hero-image">
          {
            heroImage && (
              <Image width={1020} height={510} src={heroImage} alt={title} />
            )
          }
        </div>
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={date} locale={lang} />
              {
                updatedDate && (
                  <div class="text-gray-600 dark:text-gray-400">
                    Last updated on <FormattedDate date={updatedDate} locale={lang} />
                  </div>
                )
              }
            </div>
            <h1 class="text-4xl font-bold mb-0 text-foreground">{title}</h1>
            {
              (!published || tags?.length > 0) && (
                <div class="flex items-center flex-wrap gap-2 mt-2">
                  {!published && <Badge variant="outline">Draft</Badge>}
                  {tags.map((tag) => (
                    <Badge>{tag}</Badge>
                  ))}
                </div>
              )
            }
            {
              archived && (
                <div class="text-gray-600 mt-2 dark:text-gray-400 flex flex-col">
                  <div class="flex items-center gap-2">
                    <AlertTriangleIcon aria-hidden="true" className="w-4 h-4" />
                    <span>Archived article</span>
                  </div>
                  <span>
                    This article is archived and is no longer updated.
                  </span>
                </div>
              )
            }
            <hr
              class="border-2 rounded-full not-prose my-2 mb-10 border-neutral-600 transition-colors duration-300 ease-in-out dark:border-neutral-400"
            />
          </div>
          <div
            data-article-body
            class="prose !text-left dark:prose-invert prose-h1:font-bold prose-h1:text-xl prose-a:text-gray-600 dark:prose-a:text-gray-400 prose-p:text-left prose-img:rounded-xl prose-headings:scroll-mt-24 prose-blockquote:border-neutral-600 dark:prose-blockquote:border-neutral-400"
          >
            <slot />
          </div>
          <ArticleShareButton
            client:visible
            title={title}
            description={description}
            url={articleUrl}
            lang={lang}
          />
        </div>
      </article>
    </div>
  </div>
</Layout>
