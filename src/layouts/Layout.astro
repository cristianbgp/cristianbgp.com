---
import BaseHead from "../components/BaseHead.astro";
import { AppCommand } from "@/components/AppCommand";
import { Toaster } from "@/components/ui/sonner";
import { getCollection } from "astro:content";
import { getPublishedArticles } from "@/lib/articles";
import { ClientRouter } from "astro:transitions";

type Props = {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  lang?: string;
  ogType?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  structuredData?: Record<string, unknown>;
  noIndex?: boolean;
};

const {
  title,
  description,
  image,
  imageAlt,
  lang = "en",
  ogType = "website",
  publishedTime,
  modifiedTime,
  tags,
  structuredData,
  noIndex = false,
} = Astro.props;

const [articleEntries, toolEntries] = await Promise.all([
  getCollection("articles"),
  getCollection("tools"),
]);

const articles = getPublishedArticles(articleEntries).map(
  ({ id, data }) => ({
    id,
    title: data.title,
    archived: data.archived ?? false,
    description: data.description,
    lang: data.lang,
    tags: data.tags,
  }),
);
const tools = toolEntries
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map(({ id, data }) => ({
    id,
    title: data.title,
    url: data.url,
    description: data.description,
  }));
---

<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      ogType={ogType}
      lang={lang}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      structuredData={structuredData}
      noIndex={noIndex}
    />
    <ClientRouter />
    <script is:inline>
      const getThemePreference = () => {
        if (localStorage.getItem("theme")) {
          return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };

      const syncTheme = () => {
        const isDark = document.documentElement.classList.contains("dark");
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", isDark ? "#000000" : "#ffffff");
      };

      const isDark = getThemePreference() === "dark";
      document.documentElement.classList[isDark ? "add" : "remove"]("dark");
      document.addEventListener("astro:before-swap", (event) => {
        event.newDocument.documentElement.classList.toggle(
          "dark",
          document.documentElement.classList.contains("dark"),
        );
        event.newDocument
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute(
            "content",
            document.documentElement.classList.contains("dark")
              ? "#000000"
              : "#ffffff",
          );
      });
      syncTheme();
    </script>
  </head>

  <body>
    <a
      href="#main-content"
      class="sr-only fixed top-4 left-4 z-50 rounded-md bg-background px-4 py-2 text-foreground shadow-md focus:not-sr-only"
    >
      Skip to content
    </a>
    <main
      id="main-content"
      tabindex="-1"
      class="bg-gradient-to-b to-gray-200 from-white dark:to-[#313131] dark:from-[#000000]"
    >
      <slot />
      <AppCommand
        articles={articles}
        tools={tools}
        currentPath={Astro.url.pathname}
        client:only
      />
    </main>
    <Toaster client:only />
  </body>
</html>
