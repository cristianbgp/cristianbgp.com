---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import { SITE_TITLE } from "../consts";
import ogImage from "../assets/og-image.jpg";
import type { ImageMetadata } from "astro";
import { resolvePageMetadata } from "@/lib/seo";
import { toOpenGraphLocale } from "@/lib/article-metadata";
import { getPublishedOpenGraphImagePath } from "@/lib/open-graph";

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  ogType?: "website" | "article";
  lang?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  structuredData?: Record<string, unknown>;
  noIndex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  image,
  imageAlt,
  ogType,
  lang = "en",
  publishedTime,
  modifiedTime,
  tags = [],
  structuredData,
  noIndex = false,
} = Astro.props;

const metadata = resolvePageMetadata({ title, description, ogType, noIndex });
const socialImage = image
  ? new URL(image.src, Astro.url)
  : noIndex
    ? new URL(ogImage.src, Astro.url)
    : new URL(getPublishedOpenGraphImagePath(Astro.url.pathname), Astro.site);
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
  : undefined;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{metadata.documentTitle}</title>
<meta name="title" content={metadata.documentTitle} />
<meta name="description" content={metadata.description} />
{
  "robots" in metadata && <meta name="robots" content={metadata.robots} />
}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={metadata.ogType} />
<meta property="og:locale" content={toOpenGraphLocale(lang)} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={metadata.documentTitle} />
<meta property="og:description" content={metadata.description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={imageAlt ?? metadata.documentTitle} />
{
  publishedTime && (
    <meta property="article:published_time" content={publishedTime.toISOString()} />
  )
}
{
  modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime.toISOString()} />
  )
}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={metadata.documentTitle} />
<meta property="twitter:description" content={metadata.description} />
<meta property="twitter:image" content={socialImage} />

{
  serializedStructuredData && (
    <script
      type="application/ld+json"
      set:html={serializedStructuredData}
      is:inline
    />
  )
}
