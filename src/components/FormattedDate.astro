---
interface Props {
		date: Date;
		locale?: string;
}

const { date, locale = "en" } = Astro.props;
---

<time datetime={date.toISOString()} class="text-gray-600 dark:text-gray-400">
	{
			date.toLocaleDateString(locale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
