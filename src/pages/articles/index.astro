---
import { getCollection } from "astro:content";
import ArticleListItem from "@/components/ArticleListItem.astro";
import { ArticleFilters } from "@/components/ArticleFilters";
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/Layout.astro";
import {
  ARTICLE_FILTER_QUERY_KEYS,
  getArticleFilterOptions,
  getVisibleArticles,
} from "@/lib/articles";

const posts = getVisibleArticles(await getCollection("articles"), {
  includeDrafts: import.meta.env.DEV,
})
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const { languages, tags } = getArticleFilterOptions(posts);
const currentTotal = posts.filter((post) => !post.data.archived).length;

const languageNames = new Intl.DisplayNames(["en"], { type: "language" });
const formatLanguage = (language: string) =>
  languageNames.of(language) ?? language.toUpperCase();
---

<Layout
  title="Articles"
  description="Articles about software development, product building, and game design."
>
  <script
    is:inline
    define:vars={{
      articleFilterKeys: ARTICLE_FILTER_QUERY_KEYS,
      hasArticles: posts.length > 0,
    }}
  >
    if (hasArticles) {
      const params = new URLSearchParams(window.location.search);
      if (articleFilterKeys.some((key) => params.has(key))) {
        document.documentElement.dataset.articleFiltersPending = "";
      }
    }
  </script>
  <div
    class="relative z-10 flex min-h-svh w-full flex-col items-center justify-start py-10 pointer-events-auto"
  >
    <PageHeader title="Articles">
      {
        posts.length > 0 && (
          <div
            class="mx-auto w-full max-w-2xl px-6"
            data-article-filter-surface
          >
            <ArticleFilters
              client:load
              languages={languages.map((language) => ({
                value: language,
                label: formatLanguage(language),
              }))}
              tags={tags}
              total={posts.length}
              initialVisibleTotal={currentTotal}
            />
          </div>
        )
      }
    </PageHeader>

    <div
      class="w-full max-w-2xl mx-auto p-6 space-y-10"
      data-article-filter-surface
    >
      <p
        class="mt-6 rounded-xl border border-dashed p-6 text-center text-muted-foreground"
        data-no-results
        role="status"
        hidden
      >
        No articles match those filters.
      </p>

      {
        posts.length === 0 ? (
          <p class="text-center text-2xl font-bold">Soon…</p>
        ) : (
          <ul class="mt-6 flex flex-col gap-4" data-article-list>
            {posts.map((post) => <ArticleListItem post={post} />)}
          </ul>
        )
      }
    </div>
  </div>
</Layout>
