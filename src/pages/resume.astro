---
import Layout from "../layouts/Layout.astro";
import { CommandKeyTrigger } from "@/components/AppCommand";
import ResumeViewer from "@/components/ResumeViewer.astro";
import { TypingText } from "@/components/animate-ui/text/typing";
---

<Layout
  title="Résumé"
  description="Experience, skills, and background of software engineer Cristian Granda."
>
  <div
    class="relative py-10 z-10 min-h-svh pointer-events-auto w-full flex justify-center items-center flex-col"
  >
    <div class="text-balance">
      <h1 class="sr-only">Résumé</h1>
      <TypingText
        aria-hidden="true"
        className="text-4xl font-bold"
        text="Résumé"
        cursor
        client:load
      />
    </div>
    <CommandKeyTrigger client:only />
    <ResumeViewer />
  </div>
</Layout>
