---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { ExternalLinkIcon, HouseIcon } from "lucide-react";
import { isExternalUrl } from "@/lib/navigation";

const tools = (await getCollection("tools")).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() ||
    a.data.title.localeCompare(b.data.title),
);
---

<Layout
  title="Tools"
  description="Web tools and experiments built by Cristian Granda."
>
  <div
    class="relative z-10 flex min-h-svh w-full flex-col items-center justify-start pb-10 pointer-events-auto"
  >
    <PageHeader title="Tools" />
    <div class="mx-auto w-full max-w-2xl px-6 pb-16 pt-10">
      {
        tools.length === 0 ? (
          <p class="text-center text-2xl font-bold">Soon…</p>
        ) : (
              <ul aria-label="Tools">
                {tools.map((tool) => {
                  const isExternal = isExternalUrl(tool.data.url);
                  const DestinationIcon = isExternal
                    ? ExternalLinkIcon
                    : HouseIcon;
                  const destination = isExternal
                    ? "External site (opens in a new tab)"
                    : "On this site";

                  return (
                    <li class="border-b last:border-b-0">
                      <a
                        href={tool.data.url}
                        target={isExternal ? "_blank" : undefined}
                        rel={isExternal ? "noopener noreferrer" : undefined}
                        class="group grid min-h-28 grid-cols-[1fr_auto] gap-x-5 gap-y-3 rounded-md py-5 outline-none transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4 focus-visible:ring-offset-background sm:min-h-24 sm:grid-cols-[1fr_auto]"
                      >
                        <div class="min-w-0">
                          <h2 class="text-xl font-bold tracking-tight">
                            {tool.data.title}
                          </h2>
                          <p class="mt-1 max-w-xl text-sm leading-relaxed text-muted-foreground">
                            {tool.data.description}
                          </p>
                        </div>
                        <span title={destination} class="flex size-8 items-center justify-center text-muted-foreground group-hover:text-foreground group-focus-visible:text-foreground">
                          <DestinationIcon
                            aria-hidden="true"
                            className="size-4"
                            strokeWidth={1.75}
                          />
                          <span class="sr-only">{destination}</span>
                        </span>
                        <div class="col-span-2 text-xs text-muted-foreground">
                          <FormattedDate date={tool.data.date} locale="en" />
                        </div>
                      </a>
                    </li>
                  );
                })}
              </ul>
        )
      }
    </div>
  </div>
</Layout>
