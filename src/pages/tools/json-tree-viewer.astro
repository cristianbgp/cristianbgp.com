---
import Layout from "@/layouts/Layout.astro";
import { CommandKeyTrigger } from "@/components/AppCommand";
import JsonViewerPlayground from "@/components/JsonViewerPlayground";
---

<Layout
  title="JSON Tree Viewer"
  description="Edit, validate, and explore JSON data as an interactive tree."
>
  <div
    class="relative py-10 z-10 min-h-svh pointer-events-auto w-full flex justify-center items-center flex-col"
  >
    <h1 class="text-balance text-4xl font-bold">JSON Tree Viewer</h1>
    <CommandKeyTrigger client:only />
    <JsonViewerPlayground client:only />
  </div>
</Layout>
