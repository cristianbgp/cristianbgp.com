---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import JsonViewerPlayground from "@/components/JsonViewerPlayground";
---

<Layout
  title="JSON Tree Viewer"
  description="Edit, validate, and explore JSON data as an interactive tree."
>
  <div
    class="relative z-10 flex min-h-svh w-full flex-col items-center justify-start pb-10 pointer-events-auto"
  >
    <PageHeader title="JSON Tree Viewer" />
    <div class="w-full pt-10">
      <JsonViewerPlayground client:only />
    </div>
  </div>
</Layout>
