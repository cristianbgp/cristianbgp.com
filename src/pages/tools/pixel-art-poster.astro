---
import Layout from "@/layouts/Layout.astro";
import { CommandKeyTrigger } from "@/components/AppCommand";
import { TypingText } from "@/components/animate-ui/text/typing";
import PixelArtPosterBuilder from "@/components/PixelArtPosterBuilder";
---

<Layout
  title="Pixel Art Poster"
  description="Compose pixel-art images into a custom poster and export it as PNG."
>
  <div
    class="relative py-10 z-10 min-h-svh pointer-events-auto w-full flex justify-center items-center flex-col"
  >
    <div class="text-balance">
      <h1 class="sr-only">Pixel Art Poster</h1>
      <TypingText
        aria-hidden="true"
        className="text-4xl font-bold"
        text="Pixel Art Poster"
        cursor
        client:load
      />
    </div>
    <CommandKeyTrigger client:only />
    <PixelArtPosterBuilder client:only />
  </div>
</Layout>
