---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import PixelArtPosterBuilder from "@/components/PixelArtPosterBuilder";
---

<Layout
  title="Pixel Art Poster"
  description="Compose pixel-art images into a custom poster and export it as PNG."
>
  <div
    class="relative z-10 flex min-h-svh w-full flex-col items-center justify-start pb-10 pointer-events-auto"
  >
    <PageHeader title="Pixel Art Poster" />
    <div class="w-full pt-10">
      <PixelArtPosterBuilder client:only />
    </div>
  </div>
</Layout>
